# Copy to .env and edit. Every value below is the default used when the variable is unset.

# --- Conveyor geometry -------------------------------------------------------
CONVEYOR_LENGTH_KM=5.0
SENSOR_COUNT=10
# Belt loop length in metres. Leave empty to derive it: 2 x conveyor length + 30 m of pulley wrap.
BELT_LOOP_LENGTH_M=
NOMINAL_BELT_SPEED_MPS=4.0

# --- Storage -----------------------------------------------------------------
DATA_DIR=data
DATABASE_URL=sqlite:///data/conveyor.db

# --- Backend -----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Used by the simulator, seed script and dashboard to reach the backend.
BACKEND_URL=http://127.0.0.1:8000
# A station with no reading for this long is "offline".
SENSOR_OFFLINE_TIMEOUT_S=60
# An anomaly stays "active" until the sensor has been normal for this long.
ANOMALY_CLEAR_AFTER_S=120
LOG_LEVEL=INFO

# --- Simulator ---------------------------------------------------------------
SIM_INTERVAL_S=5
SIM_SPEEDUP=1
# Chance per station per simulated day that a gradual fault starts.
SIM_FAULT_RATE=0.5
# Fraction of readings deliberately corrupted (missing, NaN, wrong type, duplicate, ...).
SIM_MESSY_RATE=0.03
SIM_SEED=42

# --- Anomaly detection and prediction -----------------------------------------
ML_MODEL_DIR=ml/models
# Number of recent readings per sensor used for rolling mean / std / slope.
ROLLING_WINDOW=24
# Expected share of anomalous rows in training data (Isolation Forest).
IFOREST_CONTAMINATION=0.02
# How much recent history the time-to-failure trend fit looks at.
TREND_LOOKBACK_MIN=180

# --- Vision ------------------------------------------------------------------
VISION_WEIGHTS=vision/models/belt_damage.pt
VISION_CONF_THRESHOLD=0.25
VISION_OUTPUT_DIR=data/vision
# Two detections closer than this along the belt loop may be the same damage.
REGISTRY_POSITION_TOLERANCE_M=5.0
# A damage not seen for this many laps is marked "not re-observed".
REGISTRY_MISSED_LAPS=3

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_REFRESH_S=5
