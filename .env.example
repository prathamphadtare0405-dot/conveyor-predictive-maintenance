# Copy to .env and edit. Every value below is the default used when the variable is unset.

# --- Conveyor geometry -------------------------------------------------------
CONVEYOR_LENGTH_KM=5.0
SENSOR_COUNT=10
# Belt loop length in metres. Leave empty to derive it: 2 x conveyor length + 30 m of pulley wrap.
BELT_LOOP_LENGTH_M=
NOMINAL_BELT_SPEED_MPS=4.0

# --- Storage -----------------------------------------------------------------
DATA_DIR=data
DATABASE_URL=sqlite:///data/conveyor.db

# --- Backend -----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Used by the simulator, seed script and dashboard to reach the backend.
BACKEND_URL=http://127.0.0.1:8000
# A station with no reading for this long is "offline".
SENSOR_OFFLINE_TIMEOUT_S=60
# An anomaly stays "active" until the sensor has been normal for this long.
ANOMALY_CLEAR_AFTER_S=120
LOG_LEVEL=INFO
# A signal that repeats exactly the same value this many times in a row is flagged "stuck".
STUCK_REPEAT_COUNT=6
# Largest batch accepted by POST /api/sensors/readings.
MAX_BATCH_SIZE=5000

# --- Simulator ---------------------------------------------------------------
SIM_INTERVAL_S=5
SIM_SPEEDUP=1
# Chance per station per simulated day that a gradual fault starts.
SIM_FAULT_RATE=0.5
# Fraction of readings deliberately corrupted (missing, NaN, wrong type, duplicate, ...).
SIM_MESSY_RATE=0.03
SIM_SEED=42
# Fixes each station's permanent sensor offsets. Keep it the same for training, evaluation and demo:
# a different value is a different conveyor.
SIM_PLANT_SEED=7

# --- Anomaly detection and prediction -----------------------------------------
ML_MODEL_DIR=ml/models
# Number of recent readings per sensor used for rolling mean / std / slope (360 x 5 s = 30 min).
ROLLING_WINDOW=360
# Share of healthy training readings allowed to score as anomalous; sets the score threshold.
IFOREST_CONTAMINATION=0.002
# An anomaly is opened after this many anomalous readings in a row (at once if severity is High or Critical).
ANOMALY_CONFIRM_READINGS=3
# A new failure prediction is computed per station every this many seconds of data time.
PREDICTION_INTERVAL_S=60
# How much recent history the time-to-failure trend fit looks at.
TREND_LOOKBACK_MIN=180

# --- Vision ------------------------------------------------------------------
VISION_WEIGHTS=vision/models/belt_damage.pt
VISION_CONF_THRESHOLD=0.25
VISION_OUTPUT_DIR=data/vision
# Two detections closer than this along the belt loop may be the same damage.
REGISTRY_POSITION_TOLERANCE_M=5.0
# The tolerance grows by this many metres per metre travelled since the reference marker.
REGISTRY_DRIFT_PER_M=0.0005
# Tolerance across the belt, as a share of the frame width.
REGISTRY_LATERAL_TOLERANCE=0.2
# Appearance score (0 to 1) needed to treat two sightings as the same damage. Measured on replayed
# test images: 97 % of repeat sightings score above 0.55, 0.4 % of different cracks do.
REGISTRY_MIN_SIMILARITY=0.55
# A damage not seen for this many laps is marked "not re-observed".
REGISTRY_MISSED_LAPS=3

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_REFRESH_S=5
